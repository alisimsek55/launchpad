# Ortam değişkenleri şablonu. Gizli bilgi İÇERMEZ; gerçek değerler .env'ye (commit edilmez)
# veya barındırma panellerine girilir. Adresler ve RPC'ler packages/shared/deployments/*.json'da.

# Hangi ağ: local (anvil fork) | testnet (herkese açık demo) | mainnet
LAUNCHPAD_NETWORK=testnet

# --- Testnet deploy (packages/contracts, script/DeployTestnet.s.sol) ---
# İmzalayan anahtar dosyada tutulmaz: `cast wallet import deployer --interactive` ile şifreli keystore
# oluştur, sonra `--account deployer` ile kullan. KEEPER = GitHub Actions keeper cüzdanının ADRESİ.
KEEPER=

# --- Indexer (apps/indexer, Render) ---
# Neon Free Postgres bağlantı adresi; boşsa yerelde gömülü PGlite kullanılır
DATABASE_URL=
# İsteğe bağlı RPC ezme (ör. PONDER_RPC_URL_46630)
PONDER_RPC_URL_46630=

# --- Web (apps/web, Vercel) ---
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_INDEXER_URL=
# İsteğe bağlı: Privy ile e-posta/sosyal giriş. Boşsa tarayıcı cüzdanı (MetaMask/Rabby) kullanılır
NEXT_PUBLIC_PRIVY_APP_ID=

# --- DCA keeper (apps/keeper; GitHub Actions'ta secret olarak) ---
# Sadece testnet gas'ı tutan ayrı bir cüzdan
KEEPER_PRIVATE_KEY=
KEEPER_RPC_URL=
POLL_MS=30000
SLIPPAGE_BPS=300
# Kalıcı durum (backoff + tarama imleci; bozuksa/yoksa sıfırdan başlar) ve multicall başına plan sayısı
KEEPER_STATE_FILE=.keeper-state.json
KEEPER_SCAN_BATCH=200
