# Ortam değişkenleri şablonu.
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldur. ".env" asla commit edilmez.
# Gizli olmayan sabitler (chain ID, adresler, parametreler) için bkz. const.md
#
# Not: Şablonun adı ".env.example" değil "env.example", çünkü Claude'un güvenlik
# ayarı ".env.*" dosyalarına erişimi engelliyor. Bu dosyada gizli bilgi yoktur.

# Robinhood Chain
RPC_URL_MAINNET=https://rpc.mainnet.chain.robinhood.com
RPC_URL_TESTNET=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630

# Deploy (sadece testnet anahtarı; mainnet deploy multisig ile yapılır)
DEPLOYER_PRIVATE_KEY=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Goldsky
GOLDSKY_API_KEY=

# Postgres (Ponder + API)
DATABASE_URL=

# Cloudflare R2 (token görselleri)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Deploy adresleri (mainnet deploy'undan sonra doldurulacak; indexer bunları okur)
TOKEN_FACTORY_ADDRESS=
BONDING_CURVE_ADDRESS=
GRADUATOR_ADDRESS=
START_BLOCK=

# Indexer RPC (production'da özel RPC, örn. Alchemy)
PONDER_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com

# Metadata API (Cloudflare R2 public URL ve api adresi)
R2_PUBLIC_URL=
API_PUBLIC_URL=
WEB_ORIGIN=

# Web (Next.js)
NEXT_PUBLIC_NETWORK=mainnet
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SUBGRAPH_URL=
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_API_URL=

# DCA keeper (mainnet: ayrı, sadece gas için az ETH tutan bir hesap; DCAVault.setKeeper ile yetkilendirilir)
KEEPER_PRIVATE_KEY=
KEEPER_RPC_URL=
POLL_MS=30000
SLIPPAGE_BPS=300
